---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { getAllEventsBySlug } from '@/lib/content';
import { formatEventDateRange, isPastEvent, withBase } from '@/lib/utils';

export async function getStaticPaths() {
  const events = await getAllEventsBySlug();
  return [...events.values()].map((event) => ({
    params: { slug: event.slug },
    props: { event }
  }));
}

const { event } = Astro.props;
const archived = isPastEvent(event);
const backHref = withBase(archived ? '/archive/' : '/', import.meta.env.BASE_URL);
---

<PublicLayout title={`${event.title} | bangalorescene.xyz`} description={event.summary}>
  <main class="shell event-detail-shell">
    <section class="masthead">
      <span class="eyebrow">{archived ? 'Archived event' : 'Upcoming event'}</span>
      <h1 class="hero-title event-detail__hero-title">{event.title}</h1>
      <p class="hero-copy">{event.summary}</p>
      <div class="nav-row">
        <a class="button" href={event.source_url} target="_blank" rel="noreferrer">Visit source listing</a>
        <button class="secondary" type="button" data-share-trigger>Share event</button>
        <a class="ghost-link" href={backHref}>{archived ? 'Back to archive' : 'Back to upcoming'}</a>
      </div>
      <p class="muted event-detail__share-status" data-share-status hidden></p>
    </section>

    <section class="event-detail-grid">
      <article class="panel media-panel">
        {event.image_url && <img class="media-panel__image" src={event.image_url} alt={event.title} />}
        <div class="media-panel__body">
        <div class="tag-row">
          <span class="tag">{event.category}</span>
          {event.neighborhood && <span class="tag">{event.neighborhood}</span>}
          {event.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
        <h2 class="event-detail__section-title">Why this event matters</h2>
        <p class="muted event-detail__summary">{event.summary}</p>
        </div>
      </article>

      <aside class="panel">
        <h3>At a glance</h3>
        <div class="event-meta">
          <span>{formatEventDateRange(event)}</span>
          <span>{event.venue_name}</span>
          {event.neighborhood && <span>{event.neighborhood}</span>}
          {event.price_text && <span>{event.price_text}</span>}
        </div>
      </aside>
    </section>
  </main>
</PublicLayout>

<style>
  .event-detail-shell {
    --section-block-gap: var(--space-2xl);
  }

  .event-detail__hero-title {
    max-width: 14ch;
  }

  .event-detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(var(--detail-sidebar-min), 0.9fr);
    gap: var(--detail-grid-gap);
    align-items: start;
  }

  .event-detail__section-title,
  .event-detail__summary,
  .event-detail__share-status {
    margin: 0;
  }

  .event-detail__share-status {
    font-size: var(--type-size-small);
  }

  @media (max-width: 900px) {
    .event-detail-grid {
      grid-template-columns: 1fr;
    }

    .event-detail-grid > aside {
      order: -1;
    }
  }
</style>

<script>
  import { shareEventLink } from '@/lib/share';

  const shareButton = document.querySelector('[data-share-trigger]');
  const shareStatus = document.querySelector('[data-share-status]');

  function showShareStatus(message) {
    if (!shareStatus) return;
    shareStatus.hidden = false;
    shareStatus.textContent = message;
  }

  function hideShareStatus() {
    if (!shareStatus) return;
    shareStatus.hidden = true;
    shareStatus.textContent = '';
  }

  shareButton?.addEventListener('click', async () => {
    try {
      const result = await shareEventLink(
        document.title.replace(' | bangalorescene.xyz', ''),
        window.location.href
      );
      if (result === 'copied') {
        showShareStatus('Event link copied to clipboard.');
        return;
      }
      hideShareStatus();
    } catch (_error) {
      hideShareStatus();
    }
  });
</script>
