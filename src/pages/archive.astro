---
import PublicLayout from '@/layouts/PublicLayout.astro';
import PublicEventFeed from '@/components/PublicEventFeed.astro';
import { getArchiveEvents } from '@/lib/content';
import { withBase } from '@/lib/utils';

const upcomingHref = withBase('/', import.meta.env.BASE_URL);
const archiveFeedUrl = withBase('/data/events/archive.json', import.meta.env.BASE_URL);
const archiveEvents = await getArchiveEvents();
---

<PublicLayout title="Archive | bangalorescene.xyz">
  <main class="shell">
    <section class="masthead">
      <span class="eyebrow">Archive</span>
      <h1 class="hero-title">Past events, kept searchable after the date passes.</h1>
      <p class="hero-copy">
        A running archive of previously approved Bangalore events, preserved so good listings stay referenceable after they end.
      </p>
      <div class="nav-row">
        <a class="button" href={upcomingHref}>Back to upcoming</a>
      </div>
    </section>

    <section>
      <div class="section-header">
        <div>
          <span class="eyebrow">Past Listings</span>
          <h2>Event history</h2>
        </div>
        <p class="section-copy">Older listings stay browsable here once they move out of the live feed.</p>
      </div>

      <PublicEventFeed
        feedUrl={archiveFeedUrl}
        initialItems={archiveEvents}
        loadingMessage="Loading archived events..."
        emptyMessage="No archived events yet. Expired approved listings will appear here automatically."
      />
    </section>
  </main>
</PublicLayout>
