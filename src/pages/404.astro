---
import PublicLayout from '@/layouts/PublicLayout.astro';
---

<PublicLayout title="Not found | bangalorescene.xyz">
  <main class="shell">
    <section class="masthead">
      <span class="eyebrow">Not found</span>
      <h1 class="hero-title hero-title--utility">That event page is missing from the current export.</h1>
      <p class="hero-copy">The record may have expired out of the active dataset, or the URL may be incorrect.</p>
      <div class="nav-row">
        <a class="button" href="/">Back to upcoming</a>
        <a class="ghost-link" href="/archive/">Browse archive</a>
      </div>
    </section>
  </main>
</PublicLayout>
