---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { getNewsletterEndpoint } from '@/lib/newsletter';

const newsletterEndpoint = getNewsletterEndpoint(import.meta.env.PUBLIC_SUPABASE_URL);
const newsletterAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
---

<PublicLayout title="bangalorescene.xyz" showFooter={false}>
  <main class="shell coming-soon-main">
    <section class="masthead">
      <span class="eyebrow">bangalorescene.xyz</span>
      <h1 class="hero-title">Bangalore’s curated events feed is coming back!</h1>
      <p class="hero-copy">
        A handpicked guide to what’s worth stepping out for in Bangalore is on the way. We’ll be live soon with a curated list of gigs.
      </p>
      <div class="nav-row">
        <button class="button" type="button" data-open-newsletter>Get notified</button>
      </div>
      <p class="coming-soon-trust">No spam. Just the launch note.</p>
    </section>

    <section class="coming-soon-values" aria-label="Why sign up">
      <article class="panel coming-soon-value-card">
        <span class="eyebrow">Curated picks</span>
        <p class="muted">A tighter shortlist of nights worth stepping out for.</p>
      </article>
      <article class="panel coming-soon-value-card">
        <span class="eyebrow">Bangalore-first</span>
        <p class="muted">Built around the city’s gigs, scenes, and local rhythms.</p>
      </article>
      <article class="panel coming-soon-value-card">
        <span class="eyebrow">No noise</span>
        <p class="muted">One launch note when we go live. Nothing extra.</p>
      </article>
    </section>
  </main>

  <div class="newsletter-modal" data-newsletter-modal hidden>
    <div class="newsletter-modal__backdrop" data-close-newsletter></div>
    <div class="newsletter-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="newsletter-modal-title">
      <button class="newsletter-modal__close" type="button" aria-label="Close newsletter form" data-close-newsletter>
        <span aria-hidden="true">&times;</span>
      </button>
      <div class="newsletter-modal__content">
        <p class="eyebrow">Newsletter</p>
        <h2 id="newsletter-modal-title" class="newsletter-modal__title">Get notified</h2>

        <div class="panel newsletter-panel">
          <div class="newsletter-state" data-newsletter-state="idle">
            <p class="newsletter-copy">
              Be the first to know when bangalorescene.xyz opens with a fresh list of gigs and shows.
            </p>

            <form
              class="newsletter-form"
              data-newsletter-form
              data-endpoint={newsletterEndpoint}
              data-anon-key={newsletterAnonKey}
              novalidate
            >
              <div
                class="newsletter-form__honeypot"
                aria-hidden="true"
              >
                <label for="newsletter-company">Company</label>
                <input
                  type="text"
                  id="newsletter-company"
                  name="company"
                  tabindex="-1"
                  autocomplete="off"
                />
              </div>
              <label class="newsletter-form__label" for="newsletter-email">
                Enter your email address to subscribe
              </label>
              <input
                class="newsletter-form__input"
                type="email"
                id="newsletter-email"
                name="email"
                autocomplete="email"
                inputmode="email"
                placeholder="name@email.com"
                required
              />
              <p class="newsletter-form__error" data-newsletter-error hidden></p>
              <button class="button newsletter-form__submit" type="submit" data-newsletter-submit>
                Keep me posted
              </button>
            </form>
          </div>

          <div class="newsletter-state newsletter-state--success" data-newsletter-state="success" hidden>
            <p class="eyebrow">Success</p>
            <h3 class="newsletter-success__title">You’re on the list</h3>
            <p class="newsletter-success__copy">
              We’ll let you know when bangalorescene.xyz goes live with a fresh list of gigs and shows.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    const modal = document.querySelector('[data-newsletter-modal]');
    const openButtons = document.querySelectorAll('[data-open-newsletter]');
    const closeButtons = document.querySelectorAll('[data-close-newsletter]');
    const form = modal?.querySelector('[data-newsletter-form]');
    const firstInput = modal?.querySelector('#newsletter-email');
    const errorNode = modal?.querySelector('[data-newsletter-error]');
    const submitButton = modal?.querySelector('[data-newsletter-submit]');
    const idleState = modal?.querySelector('[data-newsletter-state="idle"]');
    const successState = modal?.querySelector('[data-newsletter-state="success"]');
    const endpoint = form?.dataset.endpoint ?? '';
    const defaultSubmitLabel = submitButton?.textContent?.trim() ?? 'Keep me posted';
    const genericError = 'Something went wrong. Please try again.';
    const invalidEmailError = 'Enter a valid email address.';
    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    const showError = (message) => {
      if (!errorNode) return;
      errorNode.textContent = message;
      errorNode.hidden = false;
    };

    const clearError = () => {
      if (!errorNode) return;
      errorNode.textContent = '';
      errorNode.hidden = true;
    };

    const setSubmitting = (submitting) => {
      if (!submitButton) return;
      submitButton.disabled = submitting;
      submitButton.textContent = submitting ? 'Submitting...' : defaultSubmitLabel;
    };

    const showSuccess = () => {
      if (idleState) idleState.hidden = true;
      if (successState) successState.hidden = false;
      clearError();
    };

    const resetNewsletterModal = () => {
      if (form instanceof HTMLFormElement) {
        form.reset();
      }
      if (idleState) idleState.hidden = false;
      if (successState) successState.hidden = true;
      setSubmitting(false);
      clearError();
    };

    const openModal = () => {
      if (!modal) return;
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      window.setTimeout(() => firstInput?.focus(), 50);
    };

    const closeModal = () => {
      if (!modal) return;
      modal.hidden = true;
      document.body.style.overflow = '';
      resetNewsletterModal();
    };

    openButtons.forEach((button) => {
      button.addEventListener('click', openModal);
    });

    closeButtons.forEach((button) => {
      button.addEventListener('click', closeModal);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && modal && !modal.hidden) {
        closeModal();
      }
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();

      const emailInput = form.querySelector('#newsletter-email');
      const honeypotInput = form.querySelector('#newsletter-company');
      const email = emailInput instanceof HTMLInputElement ? emailInput.value.trim().toLowerCase() : '';
      const company = honeypotInput instanceof HTMLInputElement ? honeypotInput.value.trim() : '';

      clearError();

      if (!emailPattern.test(email)) {
        showError(invalidEmailError);
        emailInput?.focus();
        return;
      }

      if (!endpoint) {
        showError(genericError);
        return;
      }

      setSubmitting(true);

      const anonKey = form.dataset.anonKey ?? '';

      try {
        const headers = {
          'Content-Type': 'application/json'
        };

        if (anonKey) {
          headers.apikey = anonKey;
          headers.Authorization = `Bearer ${anonKey}`;
        }

        const response = await fetch(endpoint, {
          method: 'POST',
          headers,
          body: JSON.stringify({ email, company })
        });

        const payload = await response.json().catch(() => ({ ok: false, error: genericError }));

        if (!response.ok || !payload?.ok) {
          showError(typeof payload?.error === 'string' ? payload.error : genericError);
          setSubmitting(false);
          return;
        }

        showSuccess();
        setSubmitting(false);
      } catch {
        showError(genericError);
        setSubmitting(false);
      }
    });

  </script>
</PublicLayout>

<style>
  .coming-soon-main {
    padding-top: clamp(3rem, 10vw, 5.5rem);
  }

  .coming-soon-trust {
    margin: 0;
    color: var(--muted-soft);
    font-size: var(--type-size-small);
    font-weight: var(--type-weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .coming-soon-values {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-2xl);
  }

  .coming-soon-value-card {
    gap: var(--space-sm);
    min-height: 100%;
  }

  .coming-soon-value-card .eyebrow,
  .coming-soon-value-card .muted {
    margin: 0;
  }

  .coming-soon-value-card .muted {
    font-size: var(--type-size-body);
    text-wrap: pretty;
  }

  .newsletter-modal[hidden] {
    display: none;
  }

  .newsletter-modal {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: grid;
    place-items: center;
    padding: var(--space-2xl);
  }

  .newsletter-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(3, 8, 18, 0.72);
    backdrop-filter: blur(10px);
  }

  .newsletter-modal__dialog {
    position: relative;
    z-index: 1;
    width: min(100%, 38rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--surface);
    box-shadow: var(--shadow);
    padding: var(--space-2xl);
  }

  .newsletter-modal__content {
    display: grid;
    gap: var(--space-md);
  }

  .newsletter-modal__title {
    margin: 0;
    font-size: var(--type-size-title-section);
    line-height: var(--type-line-title);
    letter-spacing: -0.04em;
    font-weight: var(--type-weight-extrabold);
    color: var(--ink-strong);
  }

  .newsletter-modal__close {
    position: absolute;
    top: var(--space-lg);
    right: var(--space-lg);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    min-height: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    color: var(--ink-strong);
    font: inherit;
    font-size: 2.15rem;
    font-weight: var(--type-weight-semibold);
    line-height: 1;
    padding: 0;
    cursor: pointer;
  }

  .newsletter-modal__close:hover {
    transform: none;
    border: 0;
    background: transparent;
    color: var(--accent-strong);
  }

  .newsletter-modal__close:focus-visible {
    outline: 2px solid var(--line-strong);
    outline-offset: 4px;
  }

  .newsletter-panel {
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
  }

  .newsletter-state {
    display: grid;
    gap: var(--space-lg);
  }

  .newsletter-state[hidden] {
    display: none !important;
  }

  .newsletter-state--success {
    padding: var(--space-lg);
    border: 1px solid rgba(70, 216, 255, 0.24);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(180deg, rgba(70, 216, 255, 0.08), rgba(70, 216, 255, 0.03)),
      var(--surface-soft);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.02);
  }

  .newsletter-copy,
  .newsletter-success__copy {
    margin: 0;
    max-width: 31rem;
    color: var(--muted);
    font-size: var(--type-size-body-lg);
    line-height: var(--type-line-body);
  }

  .newsletter-form {
    display: grid;
    gap: var(--space-md);
    width: 100%;
  }

  .newsletter-form__label {
    color: var(--ink-strong);
    font-size: var(--type-size-small);
    font-weight: var(--type-weight-bold);
    line-height: 1.4;
  }

  .newsletter-form__input {
    width: 100%;
    max-width: 24rem;
    min-height: 3.75rem;
    padding: 0 var(--space-lg);
    border-radius: var(--radius-md);
    border: 1px solid var(--line);
    background: var(--surface-soft);
    color: var(--ink-strong);
    font: inherit;
    font-size: var(--type-size-body);
    box-shadow: none;
  }

  .newsletter-form__input::placeholder {
    color: var(--muted-soft);
  }

  .newsletter-form__input:focus {
    outline: 2px solid rgba(70, 216, 255, 0.35);
    outline-offset: 0;
    border-color: rgba(70, 216, 255, 0.6);
  }

  .newsletter-form__error {
    margin: 0;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid rgba(255, 123, 123, 0.28);
    border-radius: var(--radius-md);
    background: rgba(255, 123, 123, 0.08);
    color: #ffb4b4;
    font-size: var(--type-size-small);
    line-height: 1.5;
  }

  .newsletter-form__honeypot {
    position: absolute !important;
    left: -9999px !important;
    top: auto !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: 0 !important;
    overflow: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  .newsletter-form__submit {
    justify-self: start;
  }

  .newsletter-form__submit:disabled {
    opacity: 0.7;
    cursor: wait;
  }

  .newsletter-success__title {
    margin: 0;
    color: var(--ink-strong);
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    line-height: var(--type-line-title);
    font-weight: var(--type-weight-extrabold);
    letter-spacing: var(--type-track-tight);
  }

  .newsletter-state--success .eyebrow {
    margin: 0;
    color: var(--muted-soft);
  }

  @media (max-width: 720px) {
    .coming-soon-main {
      padding-top: var(--space-3xl);
    }

    .coming-soon-values {
      grid-template-columns: 1fr;
    }

    .newsletter-modal {
      padding: var(--space-lg);
    }

    .newsletter-modal__dialog {
      padding: var(--space-xl);
    }

    .newsletter-form__input {
      max-width: none;
    }
  }
</style>
