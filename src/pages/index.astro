---
import PublicLayout from '@/layouts/PublicLayout.astro';
import PublicEventFeed from '@/components/PublicEventFeed.astro';
import { getUpcomingEvents } from '@/lib/content';
import { withBase } from '@/lib/utils';

const archiveHref = withBase('/archive/', import.meta.env.BASE_URL);
const upcomingFeedUrl = withBase('/data/events/upcoming.json', import.meta.env.BASE_URL);
const upcomingEvents = await getUpcomingEvents();
---

<PublicLayout title="bangalorescene.xyz">
  <main class="shell">
    <section class="masthead">
      <span class="eyebrow">bangalorescene.xyz</span>
      <h1 class="hero-title">Find the city’s next good excuse to step out.</h1>
      <p class="hero-copy">
        A reviewed Bangalore events feed for nights out, neighborhood gatherings, culture drops, and the plans worth forwarding.
      </p>
      <div class="nav-row">
        <a class="button" href="#upcoming">Browse upcoming</a>
        <a class="ghost-link" href={archiveHref}>Past archive</a>
      </div>
    </section>

    <section id="upcoming">
      <div class="section-header">
        <div>
          <span class="eyebrow">Upcoming</span>
          <h2>Reviewed events ready to share</h2>
        </div>
        <p class="section-copy">Fresh picks for Bangalore, presented as a clean public feed with direct event pages.</p>
      </div>

      <PublicEventFeed
        feedUrl={upcomingFeedUrl}
        initialItems={upcomingEvents}
        loadingMessage="Loading upcoming events..."
        emptyMessage="No approved upcoming events are available yet. The next export will repopulate this feed when items are approved."
      />
    </section>
  </main>
</PublicLayout>
