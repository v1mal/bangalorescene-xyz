---
import '@fontsource-variable/plus-jakarta-sans';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'bangalorescene.xyz is a curated Bangalore events platform with a static public archive and lightweight moderation admin.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
